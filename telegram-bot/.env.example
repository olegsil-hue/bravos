# Токен бота от @BotFather (Telegram → искать @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# ID группового чата, куда бот шлёт опрос и где идёт запись игр.
# Как узнать: добавьте бота в группу, отправьте любое сообщение,
# затем откройте https://api.telegram.org/bot<TOKEN>/getUpdates
# и найдите "chat":{"id": ...} — это отрицательное число вида -1001234567890.
TELEGRAM_GROUP_CHAT_ID=

# Ваш личный Telegram user id — сюда бот шлёт результат деления на апрув.
# Узнать свой id: напишите @userinfobot в Telegram.
TELEGRAM_ADMIN_USER_ID=

# Часовой пояс для планировщика (среда 12:00 и 18:00 по этому поясу).
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных SQLite (том Railway монтируется сюда).
DB_PATH=./data/football.db
